# Copy to .env and fill in. .env is git-ignored.
# Spotify client ID: https://developer.spotify.com/dashboard
# Add the redirect URI http://127.0.0.1:8888/callback to the app's settings.
SPOTIFY_CLIENT_ID=

# Optional: where the saved Google login lives (default: ~/.config/youtubeexplode/cookies.json).
# Create it with:  java -jar spotify-nowplaying/target/spotify-nowplaying-1.0.0-SNAPSHOT.jar login
# YOUTUBE_COOKIES_FILE=

# Optional: path to yt-dlp if it is not on the PATH (used as the backup downloader).
# YT_DLP=
